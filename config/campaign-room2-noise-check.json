{
  "name": "room2-noise-check-v1",
  "written": "2026-09-23",
  "status": "diagnostic only; not run; needs orchestrator review and owner approval before any live run",
  "question": "For each of the 12 final Room 2 checkpoints, how much higher or lower is success when the policy takes its most likely action every frame (deterministic) than when it samples (stochastic), on training-side starts that are not in the held-out set?",
  "why": "Offline, fine-tuning raised the per-frame chance of sampling something other than the policy's own most likely action on demonstration crossing frames from 6.9% (clone) to 21.7% to 36.9% (checkpoints), and policy entropy rose in all 12 runs. This check measures what that noise costs in play before any observation change (options O1 or O2).",
  "task": {
    "name": "chapter-1-room-2",
    "task_definition": "config/room2.json",
    "task_definition_sha256": "979b68d1c068c88e0952a50a5b9f37b1cea0dc25e65aa517a9949c6d6d6d46bd",
    "source_route_sha256": "3ac088282e6bce43054b80b9a52105ab30b0f7a007731c0bec7daa23941dcf30",
    "start_room": "2",
    "target_room": "3"
  },
  "tool": {
