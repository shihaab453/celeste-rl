    "commit": "85bb8ed2da93f84acce2c0036daf0b0c7cab1c20",
    "git_blob": "b2acc16780795cc814fb2b3fda179233d5dd6623",
    "note": "The campaign must run at a commit whose scripts/evaluate_checkpoint.py is this same blob; the analysis script checks it. Re-pinned from 84e2777 on 2026-09-23 because a docstring was added (amendment 5); no behaviour changed."
  },
  "held_out_use": "None. config/heldout_starts-room2.json and every held-out route are never read. The tool refuses any input path naming a held-out file. These starts overlap the demonstrations by design and must never be used as held-out data.",
  "starts": {
    "canonical": "The canonical Room 2 start from config/room2.json (pinned Room 1 exit fixture, 286 frames).",
    "demonstration": {
      "built": "in memory by the tool, never written as a manifest",
      "manifest": "config/demonstrations-room2.json",
      "manifest_sha256": "7ac3f4f0fa0c9c3f0def5470cd292e20dfd9fc6975570788a153fd326dc985df",
