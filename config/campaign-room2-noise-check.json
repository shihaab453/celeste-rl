      "dataset_sha256": "0b3a3d2c3311d61d4e7464ead59fa7480b1655ff895613538222d0364e7727a9",
      "rule": "For each demonstration route, task-relative prefix lengths 40, 80, 120 and so on, up to 40 frames before that route's transition step.",
      "route_mapping": "Each dataset trajectory is matched to exactly one route by comparing its recorded applied actions with the route's lines; checked offline: trajectory t is manifest route t for all 7.",
      "frame_convention": "Dataset row k of a trajectory is the observation before action k + 1, i.e. the state after k task-relative actions; row 0 is the task start.",
      "position_reconstruction": "x = round(240 + normalised_x * 320), y = round(-184 + normalised_y * 180), dashes = round(normalised * 2); each must reproduce the stored float32 feature exactly and row 0 must be the task start (261, 1) with 0 dashes.",
      "expected_starts": {
        "20260920-021356": 12,
        "20260922-163841": 15,
        "20260922-164006": 9,
        "20260922-164111": 9,
        "20260922-164552": 10,
        "20260922-164712": 8,
        "20260922-164815": 9,
        "total": 72
      },
      "expected_start_list_sha256": "ed83e3cab1399c5d74d3e216a3ebb17a7906243620abdbb5cdcff48ed47fd525",
      "start_x_bands": {
        "before 360": 25,
        "360 to 459": 17,
        "after 459": 30
      },
      "validation": "The environment's arrival check validates every replay. Any fallback to the task start or any start problem stops that checkpoint's run (exit 3); it is a failed run, never a result.",
      "start_replay_failure": "Start validity does not depend on the policy. If any start fails to replay, stop the campaign, amend the plan to drop that start with the reason, re-commit, and restart every checkpoint from scratch. No partial rows from a stopped campaign are analysed.",
      "primary_route_counts": {
        "20260920-021356": 6,
        "20260922-163841": 9,
        "20260922-164006": 6,
        "20260922-164111": 4,
