{
  "name": "room2-stall-pilot-v1",
  "written": "2026-09-24T16:25:03+01:00",
  "label": "training-side stability pilot; a screen, not a confirmatory result; nothing reads a held-out set",
  "status": "Designed after the orchestrator reviews of 2026-09-24 (handoff, NEXT ACTIONS Objective 6); needs the owner's approval before any run.",
  "question": "In Room 2 fine-tuning from the 7-route seed-0 clone, does ending a training episode as an ordinary failure once its best progress potential has not risen for N frames reduce the collapse rate?",
  "why": "Objective 6's training runs collapsed into timeout stalls (A 4/8, B 7/8 plus one barely clearing). Stalls sit on floor no demonstration touches; rew-v2 values a stall exactly like a death; a stall uses the whole 1,800-frame deadline, about 88% of a rollout, so collapsed runs get few attempts. rew-v2 charges every failure its unspent deadline, so an early stalled ending is worth exactly a timeout: the option removes the waste without changing what any ending is worth. It cannot teach recovery from the floor, and may not help a run whose entropy has already drained.",
  "expected_effect": "Measured on the control episodes (second review): at N 296, frames per episode fall from 1,570 to at most 882 (A31), 1,381 to 822 (A32), 938 to 539 (A33) and 896 to 522 (A37): about 1.7 to 1.8 times more attempts for stuck runs, not several times, because stalls start after the last new best (A31's median no-progress stretch in timeouts is 1,194 frames), not at frame 0. Healthy runs barely change.",
  "task": {
    "name": "chapter-1-room-2",
    "task_definition": "config/room2.json",
    "task_definition_sha256": "979b68d1c068c88e0952a50a5b9f37b1cea0dc25e65aa517a9949c6d6d6d46bd",
    "source_route_sha256": "3ac088282e6bce43054b80b9a52105ab30b0f7a007731c0bec7daa23941dcf30",
    "start_room": "2",
    "target_room": "3"
  },
  "treatment": {
    "option": "--stall-frames N (TrainConfig.stall_frames; code 738297c; ending 'stalled' in FAILURES)",
    "stall_frames": 296,
    "total_timesteps": 500000,
    "n_derivation": {
      "value": 296,
      "rule": "twice the longest stretch without a strictly new best potential in any of the 21 Room 2 demonstrations (148 by the review's count, 147 by the rule's own count; 118 or 119 over the 7-route set, mostly the opening climb; at most 77 or 78 after the first new best)",
      "change_declared": "The first review set N = max(296, the smallest N cutting at most 1% of the control checkpoints' successes). That gave 815, set by the second-longest stretch in 179 successes, both from the borderline run A37. After seeing that control data and before any treatment data, the second review dropped the 1% rule as the wrong test: at N 296, 160 of 400 control episodes reach 296 frames without progress and only 11 of them go on to clear; the healthy runs lose 3 of 143 clears; after the cut point A37 clears at most 0.38 per 1,000 frames against 0.36 for a fresh episode. The final-checkpoint play without the rule and the harm check are the guard against teaching anything bad.",
      "success_cut_at_296": "11 of 179 stochastic control successes (A33 1, A34 2, A35 1, A37 7)"
    },
    "everything_else": "identical to arm A of config/campaign-room2-demos-ab.json: rew-v2, shaping 2.0, canonical start only, 500,000 transitions, checkpoints every 100,000, no training evaluations",
    "evaluation_never_uses_it": "evaluate_checkpoint.py and evaluate_heldout.py build their environment without the option (test_the_evaluators_never_enable_it)"
  },
  "controls": {
    "runs": "the existing runs/train/room2-demos-A-seed30..37 (and B-seed30..33 for the exploratory group)",
    "why_no_rerun": "Training is deterministic: old A seed 20 reproduced exactly at 3cabed1, and the option-off regression at 84272d3 reproduced A31 exactly for 143,360 steps (160 episodes; every training-determined progress column identical; only env_steps_per_second and game memory differ). Code since then touches the evaluator row fields only (3adb530).",
    "pairing_check": "In every treatment run, every episode before its first stalled ending must equal the control's episode of the same index in accepted_steps, ending, length, return, max_x, end_x, end_y and max_potential. If any pair fails, that control is rerun inside the campaign by a dated amendment before analysis.",
    "analysis_unit": "two groups of 8 after the first stall ending, not a paired test"
  },
  "primary": {
    "measure": "each final latest.zip played without the rule: 50 stochastic canonical episodes plus 1 deterministic, evaluate_checkpoint.py --episodes 50 --seed 20260924 --reward-version rew-v2 --shaping-scale 2.0, run as a second, mechanically completed campaign pinning the treatment checkpoint hashes",
    "protocol": {
      "episodes": 50,
      "seed": 20260924
    },
    "collapse_below": 0.5,
    "borderline": 0.1,
    "a_controls_already_played": "played at 3adb530 before this plan, pinned by result hash; the same checkpoints played at 84272d3 gave identical endings",
    "b_controls": "played in the same second campaign as the treatment (not yet measured, so not pinned here)"
  },
  "screen": {
    "label": "a screen only: 8 runs cannot show a small improvement",
    "max_treatment_collapses": 1,
    "harm_points": 0.1,
    "harm_check": "flag harm if the median final-checkpoint clear rate of the treatment's non-collapsed runs is more than 10 points below the control's",
    "control_collapses_by_this_measure": "5 of 8 (A30 19/50, A31 0/50, A32 0/50, A33 1/50, A34 46/50, A35 47/50, A36 50/50, A37 16/50); 4 of 8 was the training-episode measure. 5/8 is used everywhere.",
    "power_note": "With no real effect the screen passes about 0.6% of the time if the true collapse rate is 5/8, and about 16% at a pooled 5/14 (if the old A20 to A25 had 0/6 under this measure). One-sided Fisher against 5/8: 1/8 gives p 0.059, 0/8 gives p 0.013 (second review; recomputed in the analyzer's tests). Still a screen.",
    "if_it_passes": "a held-out experiment may be designed with the option; any later experiment with other clones checks its own collapse rate",
    "if_it_fails": "do not lower N below 296 (that would cut demonstrated behaviour); move to the next lever, recovery demonstrations from the stall region"
  },
